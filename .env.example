# Database
DB_URL=jdbc:postgresql://localhost:5432/fraud_detection
DB_USERNAME=fraud_user
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

# Application
SERVER_PORT=8080

# Risk Engine - Suspicious IPs (comma-separated)
SUSPICIOUS_IPS=192.168.100.1,10.0.0.1
